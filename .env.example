# Baza danych - Postgres.
# Lokalnie: `docker compose up -d` podnosi bazę na porcie 5433.
# Dane logowania są lokalne i celowo jawne, to nie jest sekret.
DATABASE_URL="postgresql://selene:selene@localhost:5433/selene?schema=public"
# Połączenie z pominięciem puli - Prisma używa go do migracji.
# Lokalnie identyczne; Neon daje na produkcji osobny adres bez `-pooler`.
DIRECT_URL="postgresql://selene:selene@localhost:5433/selene?schema=public"

# Publiczny adres strony. Używany w sitemap.xml, robots.txt, canonical i JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Powiadomienia e-mail o nowej rezerwacji (opcjonalne).
# Bez klucza aplikacja działa normalnie - rezerwacja trafia do bazy,
# a treść powiadomienia ląduje w logu serwera.
RESEND_API_KEY=""
BOOKING_NOTIFICATION_EMAIL="kontakt@selene-studio.pl"

# --- Panel salonu ---------------------------------------------------------
# Wartości poniżej są DEMONSTRACYJNE i celowo trafiają do repozytorium, żeby
# recenzent mógł zalogować się od razu po `npm install`. Na produkcji wygeneruj
# własne: `npm run hash-password -- <hasło>` oraz nowy SESSION_SECRET.
ADMIN_USER="salon"
# hasło demo: selene-demo-2026
